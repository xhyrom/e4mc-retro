{
  "schema_version": 1,
  "quilt_loader": {
    "group": "link.e4mc",
    "id": "${mod_id}",
    "version": "${version}",
    "metadata": {
      "name": "e4mc Retro",
      "description": "Open a LAN server to anyone, anywhere, anytime.",
      "contributors": {
        "skyevg": "original author",
        "xhyrom": "maintainer of backport"
      },
      "contact": {
        "homepage": "https://modrinth.com/mod/e4mc-retro/",
        "issues": "https://github.com/xhyrom/e4mc-retro/issues",
        "sources": "https://github.com/xhyrom/e4mc-retro"
      },
      "icon": "assets/${mod_id}/icon.png"
    },
    "intermediate_mappings": "net.fabricmc:intermediary",
    "entrypoints": {
      "init": "link.e4mc.E4mcClientQuilt"
    },
    "depends": [
      {
        "id": "quilt_loader",
        "versions": ">=0.19.1"
      },
      {
        "id": "minecraft",
        "versions": [
          "1.16",
          "1.16.1",
          "1.16.2",
          "1.16.3",
          "1.16.4",
          "1.16.5"
        ]
      }
    ]
